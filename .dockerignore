# Applies repo-wide (build context is the repo root for the apps/cms
# image). Patterns WITHOUT a leading slash match at every depth — so
# excluding the legacy root app's own src/server/public this way would ALSO
# swallow apps/cms/src, etc. Every legacy-root-only pattern below is
# anchored with a leading slash for exactly that reason; don't remove the
# slashes "to simplify."

# node_modules at any depth — always reinstalled fresh via pnpm inside the
# image; a copied-in host node_modules can carry macOS-built native addons
# (sharp, @swc/core) that silently break in the Linux container.
**/node_modules
**/.next
**/dist
**/*.tsbuildinfo

.git
.claude
.pnpm-store

# Legacy root Vite app (main/prod branch's app, superseded by apps/cms on
# this branch) — anchored, see note above.
/src
/server
/public
/supabase
/index.html
/vite.config.ts
/vercel.json
/bun.lockb
/ecosystem.config.cjs

# Real uploaded media and env files — media comes from a mounted volume at
# runtime (see compose.yaml), never baked into the image; env files supply
# secrets via compose's `environment`/`env_file`, never copied into a layer.
apps/cms/media
**/.env
**/.env.*
!**/.env.example
