# Read automatically by `docker compose` (repo root). Copy to `.env` and
# fill in before `docker compose up`. Distinct from apps/cms/.env.example,
# which is for running the app outside Docker.

# Any value — this is a fresh local Postgres inside the `db` volume, not a
# shared/external database.
POSTGRES_PASSWORD=

# Generate once (e.g. `openssl rand -hex 32`) and never rotate on a live
# deployment — rotating invalidates every admin session and every
# outstanding checkout submitToken.
PAYLOAD_SECRET=

# This deployment's public origin (storefront, /admin, /cms, /api — all one
# app, one origin). Local Docker default matches WEB_PORT below; set to the
# real domain (e.g. https://playbackrental.ru) in production.
WEB_URL=http://localhost:8080

# Host port the app is published on. Defaults to 8080, not 3000, because
# 3000 is a common local dev-server default and often already taken. Named
# WEB_PORT rather than CMS_PORT because it's the port the *website* is on —
# the app happens to be built on Payload CMS (Next.js), but that's an
# implementation detail, not what this variable is naming.
WEB_PORT=8080

# МойСклад JSON API 1.2 personal access token
MOYSKLAD_API_TOKEN=
MOYSKLAD_WEBHOOK_SECRET=

# External n8n workflow — see apps/cms/src/lib/notifications/webhook.ts.
# Leave empty to no-op order/contact notifications.
NOTIFICATION_WEBHOOK_URL=
