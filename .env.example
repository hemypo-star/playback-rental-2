# Read automatically by `docker compose` (repo root). Copy to `.env` and
# fill in before `docker compose up`. Distinct from apps/cms/.env.example,
# which is for running the app outside Docker.

# Any value — this is a fresh local Postgres inside the `db` volume, not a
# shared/external database.
POSTGRES_PASSWORD=

# Generate once (e.g. `openssl rand -hex 32`) and never rotate on a live
# deployment — rotating invalidates every admin session and every
# outstanding checkout submitToken.
PAYLOAD_SECRET=

# This deployment's public origin (storefront, /admin, /cms, /api — all one
# app, one origin). Local Docker default matches WEB_PORT below; set to the
# real domain (e.g. https://playbackrental.ru) in production.
WEB_URL=http://localhost:8080

# Host port the app is published on.
WEB_PORT=8080

# МойСклад JSON API 1.2 personal access token
MOYSKLAD_API_TOKEN=
MOYSKLAD_WEBHOOK_SECRET=

# Direct notifications. No n8n/external workflow is required: cms persists
# order/contact events to a local Docker volume and the `notifications`
# worker delivers them. Keep false in local dev unless you intentionally want
# to send real messages; set true on the VDS after configuring at least one
# channel below.
NOTIFICATIONS_ENABLED=false

# Telegram Bot API. Multiple chat IDs are comma-separated.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# MAX Bot API. Rotate any token that has previously been pasted/exported in
# plaintext. Multiple recipient user IDs are comma-separated.
MAX_BOT_TOKEN=
MAX_USER_IDS=

# VK community messages (optional). The community/user must be allowed to
# message every configured peer. Multiple peer IDs are comma-separated.
VK_ACCESS_TOKEN=
VK_PEER_IDS=
VK_API_VERSION=5.199

# SMTP. Port 465 + SMTP_SECURE=true = implicit TLS. Port 587 + false uses
# mandatory STARTTLS; no plaintext fallback is implemented. SMTP_ADMIN_TO
# accepts a comma-separated list. Orders also get a customer confirmation.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Playback Rental <info@playbackrental.ru>
SMTP_ADMIN_TO=PlaybackRental@yandex.ru

# Durable worker retry policy. Successful destinations are recorded per job
# and are not resent when another channel is retried.
NOTIFICATION_RETRY_MAX=5
NOTIFICATION_RETRY_BASE_MS=5000
NOTIFICATION_POLL_MS=2000
