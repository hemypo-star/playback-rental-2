# Read automatically by `docker compose` (repo root). Copy to `.env` and
# fill in before `docker compose up`. Distinct from apps/cms/.env.example
# and apps/web/.env.example, which are for running each app outside Docker.

# Any value — this is a fresh local Postgres inside the `db` volume, not a
# shared/external database.
POSTGRES_PASSWORD=

# Generate once (e.g. `openssl rand -hex 32`) and never rotate on a live
# deployment — rotating invalidates every admin session and every
# outstanding checkout submitToken.
PAYLOAD_SECRET=

# Public storefront origin. Local Docker default matches WEB_PORT below;
# set to the real domain (e.g. https://playbackrental.ru) in production.
WEB_URL=http://localhost:8080

# Host port the CMS (and, through its fallback proxy, the storefront and
# /admin) is published on. Defaults to 8080, not 3000 or 4321, because both
# are common local defaults (Docker Desktop, other dev servers) and often
# already taken. Named WEB_PORT still — it's the port the website is on,
# regardless of which service currently serves the request (see
# docs/PLAN-next-migration.md Stage 1).
WEB_PORT=8080

# МойСклад JSON API 1.2 personal access token
MOYSKLAD_API_TOKEN=
MOYSKLAD_WEBHOOK_SECRET=

# External n8n workflow — see apps/cms/src/lib/notifications/webhook.ts.
# Leave empty to no-op order/contact notifications.
NOTIFICATION_WEBHOOK_URL=
