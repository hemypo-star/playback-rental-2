# Throwaway values for the local visual preview stack only (docs/PREVIEW.md).
# Nothing here is a real credential — the stack it starts is reachable only
# from your own machine, talks to a local Postgres, and is given no МойСклад
# or notification secrets at all.
POSTGRES_PASSWORD=preview-only-not-a-secret
PAYLOAD_SECRET=preview-only-not-a-secret-change-for-any-real-deployment
WEB_URL=http://localhost:8080
WEB_PORT=8080
NOTIFICATIONS_ENABLED=false

# The admin created by the seed, for http://localhost:8080/admin
PREVIEW_ADMIN_EMAIL=demo@playback.local
PREVIEW_ADMIN_PASSWORD=DemoPassw0rd!
