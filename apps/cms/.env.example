DATABASE_URI=postgresql://user@localhost:5432/playback_cms_dev
PAYLOAD_SECRET=
WEB_URL=http://localhost:3000

# Error monitoring. Leave DSNs empty to disable.
GLITCHTIP_DSN=
NEXT_PUBLIC_GLITCHTIP_DSN=
GLITCHTIP_ENVIRONMENT=development
NEXT_PUBLIC_GLITCHTIP_ENVIRONMENT=development

# МойСклад
MOYSKLAD_API_TOKEN=
MOYSKLAD_WEBHOOK_SECRET=

# Direct notifications (no n8n). When running outside Docker, start
# `pnpm notifications:daemon` as a second process and give both processes the
# same NOTIFICATION_QUEUE_DIR. Keep disabled during ordinary local work.
NOTIFICATIONS_ENABLED=false
NOTIFICATION_QUEUE_DIR=.notification-queue
NOTIFICATION_RETRY_MAX=5
NOTIFICATION_RETRY_BASE_MS=5000
NOTIFICATION_POLL_MS=2000
NOTIFICATION_RETENTION_DAYS=30

# These delivery secrets are needed by the notification worker only. In the
# Docker deployment compose.yaml intentionally does NOT pass them to `cms`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
MAX_BOT_TOKEN=
MAX_USER_IDS=
VK_ACCESS_TOKEN=
VK_PEER_IDS=
VK_API_VERSION=5.199

# SMTP: 465 + secure=true uses implicit TLS; 587 + false uses STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Playback Rental <info@playbackrental.ru>
SMTP_ADMIN_TO=PlaybackRental@yandex.ru
SMTP_TIMEOUT_MS=15000

# Trust proxy forwarding headers only behind a reverse proxy that overwrites
# X-Real-IP and correctly appends X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Rate limiting. Defaults are deliberately permissive for real customers.
RATE_LIMIT_CHECKOUT_IP_MAX=5
RATE_LIMIT_CHECKOUT_IP_WINDOW_MS=3600000
RATE_LIMIT_CHECKOUT_PHONE_MAX=5
RATE_LIMIT_CHECKOUT_PHONE_WINDOW_MS=3600000
RATE_LIMIT_CONTACT_IP_MAX=5
RATE_LIMIT_CONTACT_IP_WINDOW_MS=3600000
RATE_LIMIT_CONTACT_EMAIL_MAX=5
RATE_LIMIT_CONTACT_EMAIL_WINDOW_MS=3600000
RATE_LIMIT_LOGIN_IP_MAX=10
RATE_LIMIT_LOGIN_IP_WINDOW_MS=900000
RATE_LIMIT_LOGIN_ACCOUNT_MAX=10
RATE_LIMIT_LOGIN_ACCOUNT_WINDOW_MS=900000
RATE_LIMIT_FORGOT_PASSWORD_IP_MAX=5
RATE_LIMIT_FORGOT_PASSWORD_IP_WINDOW_MS=3600000
RATE_LIMIT_FORGOT_PASSWORD_ACCOUNT_MAX=5
RATE_LIMIT_FORGOT_PASSWORD_ACCOUNT_WINDOW_MS=3600000
RATE_LIMIT_UNLOCK_IP_MAX=5
RATE_LIMIT_UNLOCK_IP_WINDOW_MS=3600000
RATE_LIMIT_UNLOCK_ACCOUNT_MAX=5
RATE_LIMIT_UNLOCK_ACCOUNT_WINDOW_MS=3600000
RATE_LIMIT_PROMO_VALIDATE_IP_MAX=30
RATE_LIMIT_PROMO_VALIDATE_IP_WINDOW_MS=3600000
