DATABASE_URI=postgresql://user@localhost:5432/playback_cms_dev
PAYLOAD_SECRET=

# This app's own public origin — a real CSRF defense (see cors/csrf in
# payload.config.ts), not migration-era leftover config: kept in case a
# reverse proxy/load balancer/CDN in front of this deployment rewrites
# Origin/Host. Getting this wrong is easy to miss locally: page loads
# (Server Component auth checks) still succeed either way, since a plain
# browser navigation often carries no Origin header at all (Payload's
# cookie-JWT strategy then falls back to Sec-Fetch-Site, which a same-origin
# nav satisfies regardless of the csrf allowlist) — but a same-origin fetch
# that DOES send Origin, like a Next Server Action's own POST, gets silently
# rejected if that Origin isn't in this list. Set to wherever `next dev`
# actually listens locally.
WEB_URL=http://localhost:3000

# МойСклад JSON API 1.2 personal access token
MOYSKLAD_API_TOKEN=

# External notification workflow (n8n, configured/owned outside this repo).
# Receives a POST for both order.created (checkout submit) and
# contact.created (contact form) — see apps/cms/src/lib/notifications/webhook.ts
# for the exact payload shape. Notifications are a no-op (logged, not fatal)
# if this is unset.
NOTIFICATION_WEBHOOK_URL=

MOYSKLAD_WEBHOOK_SECRET=

# Whether lib/security/clientIp.ts may believe the X-Real-IP/
# X-Forwarded-For headers on an incoming request. Default/unset = false =
# NEVER READ, and every IP-keyed rate-limit check below is skipped for that
# request (checkout/contact fall back to their phone/email dimension; login/
# forgotPassword/unlock fall back to their account dimension — see
# collections/Users.ts).
#
# This repo's own compose.yaml, as shipped, puts nothing in front of `cms` —
# it publishes the app's port straight to the host — so the safe default
# here is "don't trust", not "trust". Set this to `true` ONLY when a real
# reverse proxy sits in front of this deployment and is *known* to (a)
# overwrite, not merge, an inbound X-Real-IP from the client (nginx:
# `proxy_set_header X-Real-IP $remote_addr;` — the standard config this app
# is written against) and (b) reliably append the real peer address as
# X-Forwarded-For's last hop (`proxy_set_header X-Forwarded-For
# $proxy_add_x_forwarded_for;`). Turning this on in front of a proxy that
# does neither lets any visitor forge their own IP bucket and bypass every
# IP-keyed limit below, including admin login. See clientIp.ts's own header
# comment for the full reasoning, including why the previous version of
# this file's comment ("deployment topology settled, see the A2 task
# instructions") was wrong — no document settles this, only the product
# owner in conversation, and only for a deployment that doesn't exist yet
# in this repo's own compose stack.
TRUST_PROXY_HEADERS=false

# Rate limiting (A2, design_handoff_swiss_bento/08-instruction.md — the
# rate-limiting half of audit finding G1; see lib/security/rateLimit.ts).
# All optional — every one of these falls back to a generous default if
# unset, so a deploy that never sets any of them is still protected, just
# not tuned. Every default is deliberately biased toward never rejecting a
# real customer (a household booking two cameras from one flat, or someone
# calling back within the hour to add an item) over catching every possible
# abuse pattern — raise MAX or shrink WINDOW_MS if real abuse is seen, don't
# lower these defaults preemptively.

# Protects checkout (submitCheckout Server Action) from one IP flooding the
# public booking form. Skipped when TRUST_PROXY_HEADERS is off — checkout
# still has the phone dimension below.
RATE_LIMIT_CHECKOUT_IP_MAX=5
RATE_LIMIT_CHECKOUT_IP_WINDOW_MS=3600000

# Protects checkout from one phone number being used for repeated bogus
# bookings, independent of IP (the phone is normalized — "+7 923…" and
# "8 923…" land in the same bucket, see lib/text/phone.ts). Always checked,
# regardless of TRUST_PROXY_HEADERS — this is the dimension checkout falls
# back to when the IP one can't be trusted.
RATE_LIMIT_CHECKOUT_PHONE_MAX=5
RATE_LIMIT_CHECKOUT_PHONE_WINDOW_MS=3600000

# Protects the /contact form (POST /api/contact-notification) from one IP
# flooding the notification webhook. Skipped when TRUST_PROXY_HEADERS is
# off — the form still has the email dimension below.
RATE_LIMIT_CONTACT_IP_MAX=5
RATE_LIMIT_CONTACT_IP_WINDOW_MS=3600000

# Protects the /contact form from one email address being used for repeated
# submissions, independent of IP. Always checked, same reasoning as
# checkout's phone dimension above.
RATE_LIMIT_CONTACT_EMAIL_MAX=5
RATE_LIMIT_CONTACT_EMAIL_WINDOW_MS=3600000

# Protects admin login (POST /api/users/login) from IP-based brute-forcing.
# Tighter window than the others on purpose — a real admin mistyping a
# password a few times in a row is normal; 10 attempts in 15 minutes still
# comfortably covers that while making a password-guessing script slow.
# Skipped when TRUST_PROXY_HEADERS is off — login still has the account
# dimension below.
RATE_LIMIT_LOGIN_IP_MAX=10
RATE_LIMIT_LOGIN_IP_WINDOW_MS=900000

# Protects a single admin account from being brute-forced, independent of
# IP — the dimension login falls back to when TRUST_PROXY_HEADERS is off,
# so a login attempt isn't left completely unthrottled just because there's
# no proxy in front of this deployment yet. Keyed on the email/username
# submitted, not on whether it matches a real account, so it can't be used
# to test whether an account exists.
RATE_LIMIT_LOGIN_ACCOUNT_MAX=10
RATE_LIMIT_LOGIN_ACCOUNT_WINDOW_MS=900000

# Protects /api/users/forgot-password by IP and by the targeted account —
# same two-dimension shape as login above. Payload's own forgotPassword
# operation already avoids leaking whether an account exists; this throttle
# runs before that operation does and doesn't change that.
RATE_LIMIT_FORGOT_PASSWORD_IP_MAX=5
RATE_LIMIT_FORGOT_PASSWORD_IP_WINDOW_MS=3600000
RATE_LIMIT_FORGOT_PASSWORD_ACCOUNT_MAX=5
RATE_LIMIT_FORGOT_PASSWORD_ACCOUNT_WINDOW_MS=3600000

# Protects /api/users/unlock by IP and by the targeted account — same shape
# as forgotPassword above.
RATE_LIMIT_UNLOCK_IP_MAX=5
RATE_LIMIT_UNLOCK_IP_WINDOW_MS=3600000
RATE_LIMIT_UNLOCK_ACCOUNT_MAX=5
RATE_LIMIT_UNLOCK_ACCOUNT_WINDOW_MS=3600000
