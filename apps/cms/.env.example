DATABASE_URI=postgresql://user@localhost:5432/playback_cms_dev
PAYLOAD_SECRET=

# This app's OWN public origin — allowed for credentialed same-origin
# requests (see cors/csrf in payload.config.ts). Despite the name (kept for
# consistency with the root .env.example and compose.yaml, where it always
# meant "the public storefront URL"), this has meant *this app's* own
# address since Stage 1 of docs/PLAN-next-migration.md made apps/cms the
# single public entry point — not apps/web's. Getting this wrong is easy to
# miss: page loads (Server Component auth checks) still succeed either way,
# since a plain browser navigation often carries no Origin header at all
# (Payload's cookie-JWT strategy then falls back to Sec-Fetch-Site, which a
# same-origin nav satisfies regardless of the csrf allowlist) — but a
# same-origin fetch that DOES send Origin, like a Next Server Action's own
# POST, gets silently rejected if that Origin isn't in this list. Set to
# wherever `next dev` actually listens locally (see WEB_INTERNAL_URL below
# for the historical 4321/4322 port-drift context this is unrelated to).
WEB_URL=http://localhost:3000

# Fallback-proxy target for everything not yet ported to this app's own
# (frontend)/(admin) route groups (docs/PLAN-next-migration.md Stage 1) —
# where apps/web's own `pnpm dev` actually listens locally, not Astro's raw
# default (see CLAUDE.md's 2026-08-14 dev-log entry on the 4321/4322 drift).
# In Docker this is http://web:4321 instead (set directly in compose.yaml).
WEB_INTERNAL_URL=http://localhost:4322

# МойСклад JSON API 1.2 personal access token
MOYSKLAD_API_TOKEN=

# External notification workflow (n8n, configured/owned outside this repo).
# Receives a POST for both order.created (checkout submit) and
# contact.created (contact form) — see apps/cms/src/lib/notifications/webhook.ts
# for the exact payload shape. Notifications are a no-op (logged, not fatal)
# if this is unset.
NOTIFICATION_WEBHOOK_URL=

MOYSKLAD_WEBHOOK_SECRET=
