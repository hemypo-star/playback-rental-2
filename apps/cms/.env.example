DATABASE_URI=postgresql://user@localhost:5432/playback_cms_dev
PAYLOAD_SECRET=

# This app's own public origin — a real CSRF defense (see cors/csrf in
# payload.config.ts), not migration-era leftover config: kept in case a
# reverse proxy/load balancer/CDN in front of this deployment rewrites
# Origin/Host. Getting this wrong is easy to miss locally: page loads
# (Server Component auth checks) still succeed either way, since a plain
# browser navigation often carries no Origin header at all (Payload's
# cookie-JWT strategy then falls back to Sec-Fetch-Site, which a same-origin
# nav satisfies regardless of the csrf allowlist) — but a same-origin fetch
# that DOES send Origin, like a Next Server Action's own POST, gets silently
# rejected if that Origin isn't in this list. Set to wherever `next dev`
# actually listens locally.
WEB_URL=http://localhost:3000

# МойСклад JSON API 1.2 personal access token
MOYSKLAD_API_TOKEN=

# External notification workflow (n8n, configured/owned outside this repo).
# Receives a POST for both order.created (checkout submit) and
# contact.created (contact form) — see apps/cms/src/lib/notifications/webhook.ts
# for the exact payload shape. Notifications are a no-op (logged, not fatal)
# if this is unset.
NOTIFICATION_WEBHOOK_URL=

MOYSKLAD_WEBHOOK_SECRET=
