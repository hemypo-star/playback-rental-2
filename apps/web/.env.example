# Server-only: how this app's Node process (SSR fetches, and the reverse
# proxy in middleware.ts) reaches Payload directly. In Docker, point this at
# the cms service's internal hostname, e.g. http://cms:3000.
CMS_INTERNAL_URL=http://localhost:3000

# Browser-facing base for API calls made by React islands. Leave empty
# (same-origin) everywhere — middleware.ts reverse-proxies /api, /admin,
# /cms and /_next to Payload, so the browser never needs Payload's real
# address. PUBLIC_ vars are inlined into the client bundle at *build* time,
# so this must never point at a Docker-internal hostname.
PUBLIC_PAYLOAD_URL=
