# Server-only: how this app's Node process (SSR fetches) reaches Payload
# directly. In Docker, point this at the cms service's internal hostname,
# e.g. http://cms:3000.
CMS_INTERNAL_URL=http://localhost:3000

# Browser-facing base for API calls made by React islands. Leave empty
# (same-origin) everywhere — as of docs/PLAN-next-migration.md Stage 1, Next
# (apps/cms) is the public entry point and fallback-proxies whatever isn't
# ported there yet (including this app's own pages) to this app; either way
# Payload ends up same-origin for the browser, so it never needs Payload's
# real address. PUBLIC_ vars are inlined into the client bundle at *build*
# time, so this must never point at a Docker-internal hostname.
PUBLIC_PAYLOAD_URL=
