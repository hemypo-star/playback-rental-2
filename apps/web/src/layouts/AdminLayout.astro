---
// Shell for the custom admin UI (docs/PLAN-docker-admin.md Step 3+).
// Structure and exact spacing/radii ported from the delivered design's
// "Админка" screen — see docs/design-reference/markup.html's isAdmin
// block and dc_script.txt's adminNav/adminMeta. That mockup has no auth or
// real data (it's a static prototype); logout and per-tab badge counts are
// additions this rewrite needs that the mockup didn't have to solve.
import '../styles/global.css'
import type { AdminUser } from '../lib/admin/session'

interface NavItem {
  id: string
  label: string
  href: string
  badge?: string | number
}

interface Props {
  title: string
  subtitle?: string
  activeTab: string
  actionLabel?: string
  actionHref?: string
  user: AdminUser
}

const { title, subtitle, activeTab, actionLabel, actionHref, user } = Astro.props

// Категории/Акции aren't in the delivered mockup (it never designed a
// catalog-editing screen at all — see docs/PLAN-docker-admin.md Step 6) but
// need somewhere to live; grouped next to Склад as the other catalog-data
// tabs, styled identically to the designed items rather than bolted on
// visually differently.
const NAV: NavItem[] = [
  { id: 'orders', label: 'Заказы', href: '/admin/orders' },
  { id: 'calendar', label: 'Календарь', href: '/admin/calendar' },
  { id: 'stock', label: 'Склад', href: '/admin/stock' },
  { id: 'categories', label: 'Категории', href: '/admin/categories' },
  { id: 'promotions', label: 'Акции', href: '/admin/promotions' },
  { id: 'clients', label: 'Клиенты', href: '/admin/clients' },
  { id: 'analytics', label: 'Аналитика', href: '/admin/analytics' },
  { id: 'media', label: 'Медиатека', href: '/admin/media' },
  { id: 'users', label: 'Пользователи', href: '/admin/users' },
  { id: 'settings', label: 'Настройки', href: '/admin/settings' },
]
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · Playback Admin</title>
    <link rel="preload" href="/fonts/golos-text-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="bg-background text-foreground">
    <main class="grid min-h-screen grid-cols-[246px_1fr] gap-3.5 p-3.5" style="animation:bnFade 380ms ease both">
      <aside class="sticky top-3.5 flex h-fit flex-col gap-6 rounded-3xl bg-[#0A0A0A] p-4 py-5.5 text-white">
        <div class="flex items-baseline gap-[7px] px-2">
          <span class="text-[13px] font-bold tracking-[0.04em] uppercase">Playback</span>
          <span class="text-[13px] font-normal tracking-[0.04em] text-white/50 uppercase">Admin</span>
        </div>

        <nav class="flex flex-col gap-0.5">
          {
            NAV.map((item) => (
              <a
                href={item.href}
                class={`flex items-center justify-between rounded-[13px] px-3.5 py-3 text-[11.5px] font-semibold tracking-[0.1em] uppercase transition-colors duration-200 ${
                  activeTab === item.id ? 'bg-white text-foreground' : 'text-white/60 hover:bg-white/10 hover:text-white'
                }`}
              >
                <span>{item.label}</span>
                {item.badge ? <span class="text-[11px] opacity-60">{item.badge}</span> : null}
              </a>
            ))
          }
        </nav>

        <div class="mt-auto flex flex-col gap-0.5">
          <a
            href="/"
            class="rounded-[13px] bg-white/[0.07] px-3.5 py-3 text-[11px] font-semibold tracking-[0.1em] text-white/60 uppercase transition-colors duration-200 hover:bg-white/[0.16] hover:text-white"
          >
            ← На сайт
          </a>
          <button
            id="admin-logout"
            type="button"
            class="w-full rounded-[13px] px-3.5 py-3 text-left text-[11px] font-semibold tracking-[0.1em] text-white/40 uppercase transition-colors duration-200 hover:bg-white/10 hover:text-white/80"
          >
            Выйти · {user.email}
          </button>
        </div>
      </aside>

      <section class="flex min-w-0 flex-col gap-3.5">
        <div class="flex flex-wrap items-end justify-between gap-5 rounded-3xl border border-border bg-card px-6.5 py-5.5">
          <div>
            <h1 class="m-0 text-[28px] font-medium tracking-[-0.035em]">{title}</h1>
            {subtitle ? <div class="mt-1.5 text-[12.5px] text-subtle">{subtitle}</div> : null}
          </div>
          {
            actionLabel ? (
              <a
                href={actionHref ?? '#'}
                class="flex h-[42px] items-center gap-3 rounded-full bg-primary px-5 text-[11px] font-semibold tracking-[0.1em] text-primary-foreground uppercase transition-all duration-200 hover:gap-5 hover:bg-accent"
              >
                <span>{actionLabel}</span>
                <span>+</span>
              </a>
            ) : null
          }
        </div>

        <slot />
      </section>
    </main>
    <script>
      // /api/users/logout (proxied to the CMS) is a plain POST that returns
      // an expired Set-Cookie — a form-POST to it would navigate the whole
      // page to that raw JSON response, so this fetches it instead and
      // navigates to login itself once the cookie is actually cleared.
      document.getElementById('admin-logout')?.addEventListener('click', async () => {
        await fetch('/api/users/logout', { method: 'POST' })
        window.location.href = '/admin/login'
      })
    </script>
  </body>
</html>
