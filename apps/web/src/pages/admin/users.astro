---
import AdminLayout from '../../layouts/AdminLayout.astro'
import { getAdminToken } from '../../lib/admin/session'
import { cmsFetch } from '../../lib/admin/api'

interface AdminUserDoc {
  id: number
  email: string
}
interface FindResult {
  docs: AdminUserDoc[]
  totalDocs: number
}

const user = Astro.locals.adminUser!
const token = getAdminToken(Astro.cookies)!

const result = await cmsFetch<FindResult>('/users?sort=email&limit=100&depth=0', token)
const users = result?.docs ?? []
---

<AdminLayout title="Пользователи" subtitle={`${users.length} администраторов`} activeTab="users" user={user}>
  <p id="page-error" class="hidden rounded-2xl bg-[#FFE9E4] px-4 py-3 text-[13px] text-[#B03017]"></p>
  <p id="page-success" class="hidden rounded-2xl bg-[#E4F6E9] px-4 py-3 text-[13px] text-[#0B6B32]"></p>

  <div class="grid grid-cols-1 gap-3.5 lg:grid-cols-[1.3fr_1fr]">
    <div class="rounded-3xl border border-border bg-card p-6">
      <div class="text-[10.5px] font-semibold tracking-[0.16em] text-subtle uppercase">Администраторы</div>
      <div class="mt-3 flex flex-col gap-2">
        {
          users.map((u) => (
            <div class="flex items-center justify-between rounded-xl bg-muted px-3.5 py-2.5 text-[13.5px]" data-user-row data-user-id={u.id}>
              <span>{u.email}</span>
              {u.id !== user.id ? (
                <button type="button" data-delete-user class="text-[11px] font-semibold text-accent hover:text-[#B03017]">
                  Удалить
                </button>
              ) : (
                <span class="text-[11px] text-subtle">это вы</span>
              )}
            </div>
          ))
        }
      </div>
    </div>

    <div class="flex flex-col gap-3.5">
      <div class="rounded-3xl border border-border bg-card p-6">
        <div class="text-[10.5px] font-semibold tracking-[0.16em] text-subtle uppercase">Новый администратор</div>
        <p class="mt-1.5 text-[11.5px] text-subtle">
          Почта для рассылки не настроена — придумайте пароль сами и сообщите его новому администратору лично (например, в Telegram).
        </p>
        <label class="mt-3 block text-[11px] font-bold uppercase tracking-[0.06em] text-subtle">Email</label>
        <input id="f-new-email" type="email" class="mt-1.5 h-11 w-full rounded-xl border border-input bg-muted-well px-3.5 text-[14px] outline-none focus:border-foreground focus:bg-white" />
        <label class="mt-3 block text-[11px] font-bold uppercase tracking-[0.06em] text-subtle">Пароль</label>
        <input id="f-new-password" type="text" minlength="8" class="mt-1.5 h-11 w-full rounded-xl border border-input bg-muted-well px-3.5 text-[14px] outline-none focus:border-foreground focus:bg-white" />
        <button id="create-user-btn" type="button" class="btn-primary mt-3 w-full justify-center">Создать</button>
      </div>

      <div class="rounded-3xl border border-border bg-card p-6">
        <div class="text-[10.5px] font-semibold tracking-[0.16em] text-subtle uppercase">Сменить свой пароль</div>
        <label class="mt-3 block text-[11px] font-bold uppercase tracking-[0.06em] text-subtle">Новый пароль</label>
        <input id="f-own-password" type="text" minlength="8" class="mt-1.5 h-11 w-full rounded-xl border border-input bg-muted-well px-3.5 text-[14px] outline-none focus:border-foreground focus:bg-white" />
        <button id="change-own-password-btn" type="button" class="btn-primary mt-3 w-full justify-center">Сменить пароль</button>
      </div>
    </div>
  </div>

  <script define:vars={{ ownId: user.id }}>
    const errorEl = document.getElementById('page-error')
    const successEl = document.getElementById('page-success')
    function showError(msg) {
      successEl.classList.add('hidden')
      errorEl.textContent = msg
      errorEl.classList.remove('hidden')
    }
    function showSuccess(msg) {
      errorEl.classList.add('hidden')
      successEl.textContent = msg
      successEl.classList.remove('hidden')
    }

    document.getElementById('create-user-btn')?.addEventListener('click', async () => {
      const email = document.getElementById('f-new-email').value.trim()
      const password = document.getElementById('f-new-password').value
      if (!email || password.length < 8) {
        showError('Укажите email и пароль от 8 символов')
        return
      }
      const res = await fetch('/api/users', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password }),
      })
      const body = await res.json().catch(() => null)
      if (!res.ok) {
        showError(body?.errors?.[0]?.message || 'Не удалось создать пользователя')
        return
      }
      window.location.reload()
    })

    document.getElementById('change-own-password-btn')?.addEventListener('click', async () => {
      const password = document.getElementById('f-own-password').value
      if (password.length < 8) {
        showError('Пароль должен быть не короче 8 символов')
        return
      }
      const res = await fetch(`/api/users/${ownId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password }),
      })
      const body = await res.json().catch(() => null)
      if (!res.ok) {
        showError(body?.errors?.[0]?.message || 'Не удалось сменить пароль')
        return
      }
      document.getElementById('f-own-password').value = ''
      showSuccess('Пароль изменён.')
    })

    document.querySelectorAll('[data-user-row]').forEach((row) => {
      row.querySelector('[data-delete-user]')?.addEventListener('click', async () => {
        if (!confirm('Удалить этого администратора?')) return
        const res = await fetch(`/api/users/${row.dataset.userId}`, { method: 'DELETE' })
        if (res.ok) {
          row.remove()
        } else {
          showError('Не удалось удалить пользователя')
        }
      })
    })
  </script>
</AdminLayout>
