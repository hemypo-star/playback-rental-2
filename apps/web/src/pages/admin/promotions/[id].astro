---
import AdminLayout from '../../../layouts/AdminLayout.astro'
import { getAdminToken } from '../../../lib/admin/session'
import { cmsFetch } from '../../../lib/admin/api'
import { mediaUrl } from '../../../lib/payload'
import type { Promotion, Category, Product, PayloadFindResult } from '@playback-rental/shared-types'

const user = Astro.locals.adminUser!
const token = getAdminToken(Astro.cookies)!

const isNew = Astro.params.id === 'new'
let promo: Promotion | null = null
if (!isNew) {
  const id = Number(Astro.params.id)
  if (!Number.isFinite(id)) return Astro.redirect('/admin/promotions')
  promo = await cmsFetch<Promotion>(`/promotions/${id}?depth=0`, token)
  if (!promo) return Astro.redirect('/admin/promotions')
}

const [categoriesResult, productsResult] = await Promise.all([
  cmsFetch<PayloadFindResult<Category>>('/categories?sort=name&limit=200&depth=0', token),
  cmsFetch<PayloadFindResult<Product>>('/products?sort=title&limit=500&depth=0', token),
])
const allCategories = categoriesResult?.docs ?? []
const allProducts = productsResult?.docs ?? []

const linkedProductIds = new Set((promo?.linkedProducts ?? []).map((p) => (typeof p === 'object' ? p.id : p)))
const linkedCategoryIds = new Set((promo?.linkedCategories ?? []).map((c) => (typeof c === 'object' ? c.id : c)))
---

<AdminLayout
  title={isNew ? 'Новая акция' : promo!.title}
  subtitle={isNew ? undefined : promo!.slug ?? undefined}
  activeTab="promotions"
  user={user}
>
  <a href="/admin/promotions" class="text-[12.5px] font-semibold text-subtle hover:text-foreground">← Все акции</a>

  <p id="page-error" class="hidden rounded-2xl bg-[#FFE9E4] px-4 py-3 text-[13px] text-[#B03017]"></p>

  <div class="mt-3.5 grid grid-cols-1 gap-3.5 lg:grid-cols-[1.3fr_1fr]">
    <div class="flex flex-col gap-3.5">
      <div class="rounded-3xl border border-border bg-card p-6">
        <label class="text-[11px] font-bold uppercase tracking-[0.06em] text-subtle">Название</label>
        <input
          id="f-title"
          type="text"
          value={promo?.title ?? ''}
          class="mt-1.5 h-11 w-full rounded-xl border border-input bg-muted-well px-3.5 text-[14px] outline-none focus:border-foreground focus:bg-white"
        />

        <label class="mt-4 block text-[11px] font-bold uppercase tracking-[0.06em] text-subtle">
          Slug <span class="normal-case text-subtle/70">(если пусто — сгенерируется из названия)</span>
        </label>
        <input
          id="f-slug"
          type="text"
          value={promo?.slug ?? ''}
          class="mt-1.5 h-11 w-full rounded-xl border border-input bg-muted-well px-3.5 text-[14px] outline-none focus:border-foreground focus:bg-white"
        />

        <label class="mt-4 block text-[11px] font-bold uppercase tracking-[0.06em] text-subtle">Кикер (над заголовком в карусели)</label>
        <input
          id="f-kicker"
          type="text"
          value={promo?.kicker ?? ''}
          class="mt-1.5 h-11 w-full rounded-xl border border-input bg-muted-well px-3.5 text-[14px] outline-none focus:border-foreground focus:bg-white"
        />

        <label class="mt-4 block text-[11px] font-bold uppercase tracking-[0.06em] text-subtle">Короткий текст (в карусели)</label>
        <textarea
          id="f-text"
          rows="2"
          class="mt-1.5 w-full resize-y rounded-xl border border-input bg-muted-well px-3.5 py-2.5 text-[14px] outline-none focus:border-foreground focus:bg-white"
        >
{promo?.text ?? ''}</textarea
        >

        <label class="mt-4 block text-[11px] font-bold uppercase tracking-[0.06em] text-subtle">Полный текст (на странице акции)</label>
        <textarea
          id="f-content"
          rows="5"
          class="mt-1.5 w-full resize-y rounded-xl border border-input bg-muted-well px-3.5 py-2.5 text-[14px] outline-none focus:border-foreground focus:bg-white"
        >
{promo?.content ?? ''}</textarea
        >

        <label class="mt-4 block text-[11px] font-bold uppercase tracking-[0.06em] text-subtle">Ссылка (необязательно)</label>
        <input
          id="f-link"
          type="text"
          value={promo?.linkUrl ?? ''}
          class="mt-1.5 h-11 w-full rounded-xl border border-input bg-muted-well px-3.5 text-[14px] outline-none focus:border-foreground focus:bg-white"
        />

        <label class="mt-4 flex items-center gap-2 text-[13px]">
          <input id="f-active" type="checkbox" checked={promo?.active ?? true} class="h-4 w-4" />
          Активна (показывать в карусели)
        </label>

        <label class="mt-4 block text-[11px] font-bold uppercase tracking-[0.06em] text-subtle">Порядок</label>
        <input
          id="f-order"
          type="number"
          value={promo?.order ?? 0}
          class="mt-1.5 h-11 w-40 rounded-xl border border-input bg-muted-well px-3.5 text-[14px] outline-none focus:border-foreground focus:bg-white"
        />
      </div>

      <div class="rounded-3xl border border-border bg-card p-6">
        <div class="text-[10.5px] font-semibold tracking-[0.16em] text-subtle uppercase">Изображение (обязательно, 3:4)</div>
        <div class="mt-3 flex items-center gap-4">
          <img
            id="image-preview"
            src={mediaUrl(promo?.image) ?? ''}
            class:list={['h-24 w-20 rounded-xl object-cover bg-muted', { hidden: !promo?.image }]}
          />
          <input id="f-image" type="file" accept="image/*" class="text-[13px]" />
        </div>
        <input type="hidden" id="f-image-id" value={typeof promo?.image === 'object' ? promo?.image?.id : (promo?.image ?? '')} />
      </div>

      <div class="rounded-3xl border border-border bg-card p-6">
        <div class="text-[10.5px] font-semibold tracking-[0.16em] text-subtle uppercase">Товары на странице акции</div>
        <select id="f-linked-products" multiple size="8" class="mt-3 w-full rounded-xl border border-input bg-muted-well px-2 py-2 text-[13px] outline-none focus:border-foreground">
          {allProducts.map((p) => <option value={p.id} selected={linkedProductIds.has(p.id)}>{p.title}</option>)}
        </select>
        <p class="mt-1.5 text-[11.5px] text-subtle">Ctrl/Cmd + клик для выбора нескольких.</p>
      </div>

      <div class="rounded-3xl border border-border bg-card p-6">
        <div class="text-[10.5px] font-semibold tracking-[0.16em] text-subtle uppercase">Категории на странице акции</div>
        <select id="f-linked-categories" multiple size="6" class="mt-3 w-full rounded-xl border border-input bg-muted-well px-2 py-2 text-[13px] outline-none focus:border-foreground">
          {allCategories.map((c) => <option value={c.id} selected={linkedCategoryIds.has(c.id)}>{c.name}</option>)}
        </select>
      </div>
    </div>

    <div class="flex flex-col gap-3.5">
      <div class="rounded-3xl border border-border bg-card p-6">
        <button id="save-btn" type="button" data-is-new={String(isNew)} data-promo-id={promo?.id} class="btn-primary w-full justify-center">
          {isNew ? 'Создать' : 'Сохранить'}
        </button>
        {
          !isNew ? (
            <button
              id="delete-btn"
              type="button"
              class="mt-3 w-full rounded-full bg-transparent px-4 py-2.5 text-[11px] font-semibold tracking-[0.1em] text-accent uppercase transition-colors duration-200 hover:bg-accent hover:text-white"
            >
              Удалить акцию
            </button>
          ) : null
        }
        {
          !isNew && promo?.slug ? (
            <a
              href={`/promotions/${promo.slug}`}
              target="_blank"
              class="mt-3 block text-center text-[12px] text-subtle hover:text-accent"
            >
              Открыть на сайте →
            </a>
          ) : null
        }
      </div>
    </div>
  </div>

  <script>
    import { uploadMedia } from '../../../scripts/admin-media-upload'

    const errorEl = document.getElementById('page-error')!
    function showError(msg: string) {
      errorEl.textContent = msg
      errorEl.classList.remove('hidden')
    }

    const saveBtn = document.getElementById('save-btn') as HTMLButtonElement
    const isNew = saveBtn.dataset.isNew === 'true'
    const promoId = saveBtn.dataset.promoId

    document.getElementById('f-image')?.addEventListener('change', async (e) => {
      const file = (e.target as HTMLInputElement).files?.[0]
      if (!file) return
      try {
        const media = await uploadMedia(file)
        ;(document.getElementById('f-image-id') as HTMLInputElement).value = String(media.id)
        const preview = document.getElementById('image-preview') as HTMLImageElement
        preview.src = media.url
        preview.classList.remove('hidden')
      } catch (err) {
        showError(err instanceof Error ? err.message : 'Не удалось загрузить файл')
      }
    })

    function selectedIds(selectId: string): number[] {
      const el = document.getElementById(selectId) as HTMLSelectElement
      return Array.from(el.selectedOptions).map((o) => Number(o.value))
    }

    saveBtn.addEventListener('click', async () => {
      errorEl.classList.add('hidden')
      const imageId = (document.getElementById('f-image-id') as HTMLInputElement).value
      if (!imageId) {
        showError('Изображение обязательно')
        return
      }
      const data = {
        title: (document.getElementById('f-title') as HTMLInputElement).value,
        slug: (document.getElementById('f-slug') as HTMLInputElement).value || undefined,
        kicker: (document.getElementById('f-kicker') as HTMLInputElement).value,
        text: (document.getElementById('f-text') as HTMLTextAreaElement).value,
        content: (document.getElementById('f-content') as HTMLTextAreaElement).value,
        linkUrl: (document.getElementById('f-link') as HTMLInputElement).value,
        active: (document.getElementById('f-active') as HTMLInputElement).checked,
        order: Number((document.getElementById('f-order') as HTMLInputElement).value) || 0,
        image: Number(imageId),
        linkedProducts: selectedIds('f-linked-products'),
        linkedCategories: selectedIds('f-linked-categories'),
      }

      const url = isNew ? '/api/promotions' : `/api/promotions/${promoId}`
      const res = await fetch(url, {
        method: isNew ? 'POST' : 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      })
      const body = await res.json().catch(() => null)
      if (!res.ok) {
        showError(body?.errors?.[0]?.message || 'Не удалось сохранить')
        return
      }
      window.location.href = isNew ? `/admin/promotions/${body.doc.id}` : '/admin/promotions'
    })

    document.getElementById('delete-btn')?.addEventListener('click', async () => {
      if (!confirm('Удалить эту акцию?')) return
      const res = await fetch(`/api/promotions/${promoId}`, { method: 'DELETE' })
      if (res.ok) {
        window.location.href = '/admin/promotions'
      } else {
        showError('Не удалось удалить')
      }
    })
  </script>
</AdminLayout>
