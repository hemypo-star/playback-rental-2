---
import AdminLayout from '../../layouts/AdminLayout.astro'
import { getAdminToken } from '../../lib/admin/session'
import { cmsFetch } from '../../lib/admin/api'
import { mediaUrl } from '../../lib/payload'
import type { PayloadFindResult, Media } from '@playback-rental/shared-types'

const user = Astro.locals.adminUser!
const token = getAdminToken(Astro.cookies)!

const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1)
const PER_PAGE = 60
const result = await cmsFetch<PayloadFindResult<Media>>(`/media?sort=-createdAt&limit=${PER_PAGE}&page=${page}&depth=0`, token)
const items = result?.docs ?? []
---

<AdminLayout title="Медиатека" subtitle={`${result?.totalDocs ?? 0} файлов`} activeTab="media" user={user}>
  <p id="page-error" class="hidden rounded-2xl bg-[#FFE9E4] px-4 py-3 text-[13px] text-[#B03017]"></p>

  <div class="rounded-3xl border border-border bg-card p-6">
    <div id="media-grid" class="grid grid-cols-2 gap-3.5 sm:grid-cols-4 lg:grid-cols-6">
      {
        items.map((m) => (
          <div class="rounded-xl border border-border p-2" data-media-item data-media-id={m.id}>
            <img src={mediaUrl(m)} class="aspect-square w-full rounded-lg object-cover bg-muted" />
            <input
              type="text"
              data-alt-input
              value={m.alt ?? ''}
              placeholder="Alt текст"
              class="mt-1.5 h-8 w-full rounded-lg border border-input bg-muted-well px-2 text-[11.5px] outline-none focus:border-foreground focus:bg-white"
            />
            <div class="mt-1.5 flex items-center justify-between">
              <button type="button" data-save-alt class="text-[10.5px] font-semibold text-subtle hover:text-foreground">
                Сохранить
              </button>
              <button type="button" data-delete-media class="text-[10.5px] font-semibold text-accent hover:text-[#B03017]">
                Удалить
              </button>
            </div>
          </div>
        ))
      }
    </div>
    {items.length === 0 ? <div class="px-2.5 py-8 text-center text-[13.5px] text-subtle">Пока нет файлов</div> : null}

    {
      result && result.totalPages > 1 ? (
        <div class="mt-6 flex items-center justify-center gap-3">
          {page > 1 ? (
            <a href={`/admin/media?page=${page - 1}`} class="text-[12.5px] font-semibold text-subtle hover:text-foreground">
              ← Раньше
            </a>
          ) : null}
          <span class="text-[12.5px] text-subtle">
            {page} / {result.totalPages}
          </span>
          {page < result.totalPages ? (
            <a href={`/admin/media?page=${page + 1}`} class="text-[12.5px] font-semibold text-subtle hover:text-foreground">
              Позже →
            </a>
          ) : null}
        </div>
      ) : null
    }
  </div>

  <script>
    const errorEl = document.getElementById('page-error')!
    function showError(msg: string) {
      errorEl.textContent = msg
      errorEl.classList.remove('hidden')
    }

    document.querySelectorAll<HTMLElement>('[data-media-item]').forEach((item) => {
      const id = item.dataset.mediaId

      item.querySelector('[data-save-alt]')?.addEventListener('click', async () => {
        errorEl.classList.add('hidden')
        const alt = (item.querySelector('[data-alt-input]') as HTMLInputElement).value
        const res = await fetch(`/api/media/${id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ alt }),
        })
        if (!res.ok) showError('Не удалось сохранить alt-текст')
      })

      item.querySelector('[data-delete-media]')?.addEventListener('click', async () => {
        if (!confirm('Удалить этот файл? Если он используется в товаре/акции/категории, удаление может нарушить отображение.')) return
        const res = await fetch(`/api/media/${id}`, { method: 'DELETE' })
        if (res.ok) {
          item.remove()
        } else {
          showError('Не удалось удалить — возможно, файл используется')
        }
      })
    })
  </script>
</AdminLayout>
