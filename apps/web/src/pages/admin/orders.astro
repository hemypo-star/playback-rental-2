---
import AdminLayout from '../../layouts/AdminLayout.astro'
import KpiCards from '../../components/admin/KpiCards.astro'
import { getAdminToken } from '../../lib/admin/session'
import { getAdminKpi, getAdminOrders } from '../../lib/admin/api'
import { rub, formatDate, ORDER_STATUS_TONE } from '../../lib/admin/format'

const user = Astro.locals.adminUser!
const token = getAdminToken(Astro.cookies)!

const [kpi, { orders }] = await Promise.all([getAdminKpi(token), getAdminOrders(token)])
---

<AdminLayout title="Очередь заявок" subtitle={`${orders.length} последних заказов`} activeTab="orders" user={user}>
  <KpiCards kpi={kpi} />

  <div class="rounded-3xl border border-border bg-card p-6">
    <div class="grid grid-cols-[90px_1.6fr_1.4fr_1fr_110px_130px] gap-3.5 px-2.5 pb-3 text-[10px] font-semibold tracking-[0.13em] text-subtle uppercase">
      <span>Номер</span><span>Клиент</span><span>Позиции</span><span>Даты</span><span>Сумма</span><span>Статус</span>
    </div>
    {
      orders.map((o, i) => {
        const tone = ORDER_STATUS_TONE[o.status]
        const [start, end] = o.dates ? o.dates.split('|') : [null, null]
        return (
          <a
            href={`/admin/orders/${o.id}`}
            class="grid grid-cols-[90px_1.6fr_1.4fr_1fr_110px_130px] items-center gap-3.5 rounded-2xl px-2.5 py-3.5 text-[13.5px] transition-colors duration-200 hover:bg-muted"
            style={`animation:bnIn 560ms cubic-bezier(0.16,1,0.3,1) both;animation-delay:${Math.min(i * 55, 400)}ms`}
          >
            <span class="font-semibold">#{o.id}</span>
            <span class="truncate">{o.customerName}</span>
            <span class="truncate text-[12.5px] text-subtle">{o.itemsSummary}</span>
            <span class="text-[12.5px] text-subtle">{start && end ? `${formatDate(start)} – ${formatDate(end)}` : '—'}</span>
            <span class="font-semibold">{rub(o.totalPrice)}</span>
            <span
              class="justify-self-start rounded-full px-3 py-1.5 text-[10px] font-semibold tracking-[0.1em] uppercase"
              style={{ background: tone.bg, color: tone.color }}
            >
              {tone.label}
            </span>
          </a>
        )
      })
    }
    {
      orders.length === 0 ? (
        <div class="px-2.5 py-8 text-center text-[13.5px] text-subtle">Заказов пока нет</div>
      ) : null
    }
  </div>
</AdminLayout>
