---
import AdminLayout from '../../layouts/AdminLayout.astro'
import { getAdminToken } from '../../lib/admin/session'
import { getAdminStock } from '../../lib/admin/api'
import { rub, STOCK_STATUS_TONE } from '../../lib/admin/format'

const user = Astro.locals.adminUser!
const token = getAdminToken(Astro.cookies)!

const { products } = await getAdminStock(token)
---

<AdminLayout title="Склад и цены" subtitle={`${products.length} позиций`} activeTab="stock" user={user}>
  <div class="rounded-3xl border border-border bg-card p-6">
    <div class="grid grid-cols-[2fr_1.2fr_90px_110px_130px] gap-3.5 px-2.5 pb-3 text-[10px] font-semibold tracking-[0.13em] text-subtle uppercase">
      <span>Позиция</span><span>Категория</span><span>Остаток</span><span>Цена</span><span>Статус</span>
    </div>
    {
      products.map((p, i) => {
        const tone = STOCK_STATUS_TONE[p.status]
        return (
          <a
            href={`/admin/products/${p.id}`}
            class="grid grid-cols-[2fr_1.2fr_90px_110px_130px] items-center gap-3.5 rounded-2xl px-2.5 py-3.5 text-[13.5px] transition-colors duration-200 hover:bg-muted"
            style={`animation:bnIn 560ms cubic-bezier(0.16,1,0.3,1) both;animation-delay:${Math.min(i * 55, 400)}ms`}
          >
            <span class="truncate font-medium">{p.title}</span>
            <span class="truncate text-[12.5px] text-subtle">{p.category ?? '—'}</span>
            <span>{p.quantity}</span>
            <span class="font-semibold">{rub(p.price)}</span>
            <span
              class="justify-self-start rounded-full px-3 py-1.5 text-[10px] font-semibold tracking-[0.1em] uppercase"
              style={{ background: tone.bg, color: tone.color }}
            >
              {tone.label}
            </span>
          </a>
        )
      })
    }
    {products.length === 0 ? <div class="px-2.5 py-8 text-center text-[13.5px] text-subtle">Пока нет товаров</div> : null}
  </div>
</AdminLayout>
