---
import Layout from '../../layouts/Layout.astro'
import CatalogPage from '../../components/CatalogPage.astro'
import { getCategoryBySlug } from '../../lib/payload'

const { slug } = Astro.params
const category = slug ? await getCategoryBySlug(slug) : undefined

if (!category) {
  return Astro.redirect('/catalog')
}

const searchQuery = Astro.url.searchParams.get('q') ?? undefined
const sort = Astro.url.searchParams.get('sort') ?? undefined
---

<Layout title={category.name}>
  <CatalogPage activeCategory={category} searchQuery={searchQuery} sort={sort} />
</Layout>
